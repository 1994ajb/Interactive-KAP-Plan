# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth (set to 'true' to require @campfire.co.uk login)
NEXT_PUBLIC_REQUIRE_AUTH=false

# HubSpot (EU instance)
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token

# Anthropic (AI layer)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Clay (contact/company enrichment)
CLAY_API_KEY=your-clay-api-key

# Gmail (email intelligence)
GMAIL_ACCESS_TOKEN=your-gmail-access-token
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Google Calendar (meeting intelligence)
GOOGLE_CALENDAR_TOKEN=your-google-calendar-token

# Slack (internal comms monitoring)
SLACK_BOT_TOKEN=your-slack-bot-token

# Supermetrics (campaign performance)
SUPERMETRICS_API_KEY=your-supermetrics-api-key

# Meta Ad Library (competitor/brand ad monitoring)
META_AD_LIBRARY_TOKEN=your-meta-ad-library-token

# Google News API (news monitoring)
GOOGLE_NEWS_API_KEY=your-google-news-api-key

# Companies House (UK corporate data)
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Apollo.io (contact enrichment — Phase 3)
APOLLO_API_KEY=your-apollo-api-key

# Similarweb (website analytics — Phase 3)
SIMILARWEB_API_KEY=your-similarweb-api-key
